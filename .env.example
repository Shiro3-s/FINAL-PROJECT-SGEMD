# Plantilla de variables de entorno para el frontend standalone (Vite 8 / Vercel).
# En desarrollo local, el proxy de Vite redirige `/api` a `VITE_DEV_PROXY_TARGET`.
# En Vercel, las peticiones a `/api/*` pueden enrutarse mediante `vercel.json` o `VITE_API_BASE_URL`.

VITE_DEV_PROXY_TARGET=http://localhost:3000
