# Plantilla de variables. Copiar a `.env` (`make env`) y rellenar los secretos.
# Ningún valor real de producción va en este archivo.

# --- Aplicación ---
NODE_ENV=development
PORT=3000
# Origen público único (el que ve el navegador). Debe coincidir con el hostname de Caddy.
APP_ORIGIN=https://localhost
# Hostname que sirve Caddy. En localhost usa su CA interna.
APP_HOST=localhost
# Límite de cuerpo del proxy en MB. Es el único valor que vive fuera de configuracion_programa.
PROXY_MAX_BODY_MB=500
# Poner en false SOLO para desarrollo local sin HTTPS.
COOKIE_SECURE=true

# --- Base de datos ---
POSTGRES_DB=sgemd
POSTGRES_USER=sgemd
POSTGRES_PASSWORD=cambiame
DATABASE_URL=postgres://sgemd:cambiame@postgres:5432/sgemd

# --- Secretos (generar con: openssl rand -hex 32) ---
JWT_SECRET=
OTP_HMAC_SECRET=

# --- Correo ---
# file | relay | oauth2
MAIL_TRANSPORT=file
MAIL_FROM=SGEMD <no-reply@uniminuto.edu>
MAIL_FILE_DIR=/app/storage/mail
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_OAUTH_CLIENT_ID=
MAIL_OAUTH_CLIENT_SECRET=
MAIL_OAUTH_REFRESH_TOKEN=
MAIL_OAUTH_TENANT_ID=

# --- Almacenamiento ---
STORAGE_DIR=/app/storage
BACKUPS_DIR=/app/backups
