flowchart LR
  subgraph Cliente["Cliente / Navegador"]
    UI["React SPA<br/>Router + PrivateRoute"]
    PAG["Páginas por rol<br/>Admin · Docente · Estudiante"]
    CMP["Componentes UI<br/>Sidebars, tablas, formularios, gráficos"]
    API["api.js<br/>Cliente HTTP + manejo 401/403"]
  end

  subgraph Backend["Backend Node.js + Express"]
    RUT["routes"]
    CTR["controllers"]
    SVC["services"]
    MW["middlewares<br/>authenticateToken · isAdmin · isTeacher · isStudent"]
    CFG["config<br/>db (pool pg) · mailer · jwt"]
    SOCK["Socket.io<br/>Notificaciones en tiempo real"]
    FIL["File storage<br/>Uploads locales (≤ 500 MB)"]
  end

  subgraph Persistencia["Persistencia / Infraestructura"]
    DB[("PostgreSQL 17<br/>Pool de conexiones pg")]
    DOCKER["docker-compose.yml<br/>frontend · backend · postgres"]
    SMTP["Mailer SMTP<br/>OTP 8 dígitos / 5 min"]
  end

  UI --> PAG
  PAG --> CMP
  UI --> API
  API -->|"HTTP/JSON + Bearer JWT + CORS"| RUT
  RUT -.->|"Validación por rol y alcance"| MW
  RUT --> CTR
  CTR --> SVC
  SVC -.-> CFG
  CFG -->|"Consultas parametrizadas"| DB
  SVC --> SOCK
  SVC --> FIL
  SVC -->|"Envío de OTP"| SMTP
  SOCK -.->|"Notificaciones tiempo real"| UI
  DOCKER -.->|"Conteneriza"| UI
  DOCKER -.->|"Conteneriza"| Backend
  DOCKER -.->|"Conteneriza"| DB