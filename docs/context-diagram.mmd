---
title: Diagrama de Contexto — SGEMD
---
%% Diagrama de contexto (nivel 1 de C4) dibujado como flowchart para controlar
%% el trazado: los actores quedan siempre arriba, el sistema al centro y los
%% sistemas externos abajo. Al no haber conexiones entre actores ni entre
%% externos, ninguna línea se cruza; las etiquetas se dibujan sobre fondo
%% blanco para que el trazo no las atraviese.
%%{init: {'themeVariables': {'edgeLabelBackground': '#FFFFFF'}}}%%
flowchart TB
    admin["<b>Administrador</b><br/><small>Coordinador del Centro Progresa</small>"]
    docente["<b>Docente / Mentor</b><br/><small>Asesor de los emprendimientos asignados</small>"]
    estudiante["<b>Estudiante</b><br/><small>Emprendedor</small>"]
    auditor["<b>Auditor (Post-MVP)</b><br/><small>Consulta y exporta, solo lectura</small>"]

    sgemd["<b>SGEMD</b><br/>Plataforma web React + Node.js<br/><small>Usuarios · Emprendimientos · Seguimiento<br/>Tareas · Asesorías · Diagnóstico · Eventos</small>"]

    smtp["<b>Servicio SMTP</b>"]
    db["<b>PostgreSQL 17</b><br/><small>41 tablas</small>"]
    files["<b>Almacenamiento</b><br/>de archivos"]
    backup["<b>Respaldos</b><br/>institucionales"]

    admin -->|"Gestiona usuarios,<br/>aprobaciones y configuración"| sgemd
    docente -->|"Registra avances<br/>y califica"| sgemd
    estudiante -->|"Diligencia diagnóstico<br/>y completa tareas"| sgemd
    auditor -.->|"Consulta reportes"| sgemd

    sgemd -->|"Envía OTP y<br/>correo de bienvenida"| smtp
    sgemd -->|"Lee y escribe<br/>consultas parametrizadas"| db
    sgemd -->|"Guarda adjuntos<br/>y evidencias"| files
    sgemd -->|"Escribe copias<br/>programadas"| backup

    classDef actor fill:#EAF2FB,stroke:#2F5597,stroke-width:1.5px,color:#1F3864
    classDef system fill:#1F3864,stroke:#1F3864,stroke-width:2px,color:#FFFFFF
    classDef external fill:#F2F2F2,stroke:#7F7F7F,stroke-width:1px,stroke-dasharray:5 4,color:#333333

    class admin,docente,estudiante,auditor actor
    class sgemd system
    class smtp,db,files,backup external
