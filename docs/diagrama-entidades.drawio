<mxCell id="leyenda" value="&lt;b&gt;Convenciones y correcciones aplicadas&lt;/b&gt;&lt;br&gt;PK llave primaria &amp;#183; FK llave foranea &amp;#183; UQ unico&lt;br&gt;tick = 1 &amp;#183; circulo = 0..1 &amp;#183; pata de gallina = N&lt;br&gt;A : B = cardinalidad de A hacia B&lt;br&gt;&lt;br&gt;Morado = entidad agregada al corregir el modelo:&lt;br&gt;1. asesorias.emprendimiento_id (FR-006)&lt;br&gt;2. caracterizaciones = insumo del diagnostico&lt;br&gt;3. fecha_horarios 0..1 + UQ en asesorias (ACID)&lt;br&gt;4. habilitaciones = modulo por persona, no por rol&lt;br&gt;5. adjuntos + 3 pivotes (FR-008, max 500 MB)&lt;br&gt;D3. todas las columnas en snake_case&lt;br&gt;D4. codigos_verificacion.usuario_id (ya no por correo)&lt;br&gt;Fuera: evaluacioneshabilidades, solicitudestutoria" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="20" y="1110" width="780" height="320" as="geometry"/></mxCell>
